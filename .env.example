# Browser configuration (the Supabase anon/publishable key is intended for client use).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APPS_SCRIPT_URL=
# Set to false to close booking (omit or set true to open the portal)
VITE_BOOKING_ENABLED=true

# Server-only configuration — stored in Apps Script Script Properties, never committed.
# ADMIN_EMAILS: comma-separated list of admin Gmail addresses
# SPREADSHEET_ID: the Google Sheet ID for the student database
# FORM_RESPONSES_SPREADSHEET_ID: the Google Form responses sheet ID (applicant allowlist)
# BOOKING_ENABLED: set to "true" in Script Properties to open student slot booking
# APPS_SCRIPT_HMAC_SECRET: HMAC secret for token signing
APPS_SCRIPT_WEB_APP_URL=
APPS_SCRIPT_HMAC_SECRET=
SUPABASE_JWT_SECRET=
SPREADSHEET_ID=
